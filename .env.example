# --- Required ---
DISCORD_TOKEN=put-your-bot-token-here
GUILD_ID=put-your-server-id-here

# --- Already filled from your setup ---
LOG_CHANNEL_ID=1482835040600588328
FORUM_CHANNEL_ID=1555637461944897596
APPY_BOT_ID=853327905357561948

# Optional: tag to apply to new forum posts (right-click tag -> copy ID, blank = none)
APPROVED_TAG_ID=

# Optional: true = log embeds but don't post (tuning parser). false = live.
DRY_RUN=false
DEBUG_DUMP=false

# Port for health server (free hosts set PORT automatically, leave 3000 locally)
PORT=3000
